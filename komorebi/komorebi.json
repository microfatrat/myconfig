{
  "monitors": [
    {
      "workspaces": [
        { "name": "1:home", "layout": "BSP" },
        { "name": "2:term", "layout": "BSP" },
        {
          "name": "3:code",
          "layout": "BSP",
          "workspace_rules": [
            { "kind": "Exe", "matching_strategy": "Equals", "id": "Zed.exe" }
          ]
        },
        {
          "name": "4:web",
          "layout": "BSP",
          "workspace_rules": [
            { "kind": "Exe", "matching_strategy": "Equals", "id": "msedge.exe" }
          ]
        },
        {
          "name": "5:chat",
          "layout": "BSP",
          "workspace_rules": [
            { "kind": "Exe", "matching_strategy": "Equals", "id": "QQ.exe" },
            { "kind": "Exe", "matching_strategy": "Equals", "id": "WeChat.exe" }
          ]
        },
        { "name": "6:game", "layout": "BSP" },
        { "name": "7:misc", "layout": "BSP" }
      ]
    }
  ],
  "border": true,
  "border_width": 4,
  "border_offset": -1,
  "default_container_padding": 4,
  "default_workspace_padding": 4,
  "border_style": "Square",
  "border_colours": {
    "single": "#89B4FA",
    "stack": "#F38BA8",
    "monocle": "#A6E3A1",
    "unfocused": "#585B70"
  },
  "floating_applications": [
    { "kind": "Exe", "matching_strategy": "Equals", "id": "Taskmgr.exe" },
    [
      {
        "kind": "Exe",
        "matching_strategy": "Equals",
        "id": "ApplicationFrameHost.exe"
      },
      { "kind": "Title", "matching_strategy": "Equals", "id": "设置" }
    ],
    [
      {
        "kind": "Exe",
        "matching_strategy": "Equals",
        "id": "ApplicationFrameHost.exe"
      },
      { "kind": "Title", "matching_strategy": "Equals", "id": "Calculator" }
    ],
    { "kind": "Exe", "matching_strategy": "Equals", "id": "SnippingTool.exe" },
    [
      {
        "kind": "Exe",
        "matching_strategy": "Equals",
        "id": "steamwebhelper.exe"
      },
      { "kind": "Class", "matching_strategy": "Equals", "id": "SDL_app" },
      {
        "kind": "Title",
        "matching_strategy": "StartsWith",
        "id": "notificationtoasts"
      }
    ]
  ],
  "animation": {
    "enabled": true,
    "duration": 120,
    "style": "EaseInOutSine",
    "fps": 60
  },
  "cross_monitor_move_behaviour": "Swap",
  "unmanaged_window_operation_behaviour": "Op"
}
